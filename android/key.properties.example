# Release signing config for Android. Copy this file to `key.properties`
# (same directory) and fill in your real values. NEVER commit key.properties
# or the .jks keystore — both are gitignored.
#
# 1. Generate an upload keystore (once):
#    keytool -genkey -v -keystore ~/edutech-upload.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Point storeFile at that .jks and set the passwords/alias below.
#
# storeFile can be an absolute path or relative to the android/ directory.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/edutech-upload.jks
