<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug-only overrides.

      usesCleartextTraffic lives HERE, not in the main manifest. In the main
      manifest it applied to release builds too, which meant every admin-supplied
      URL the app loads — hero_image, image_url, notification_pdf_url,
      application_link, official_website_url, book file_url, a gateway's
      pay_page_url — could be served over plaintext http:// and read or modified
      on a hostile network. It is only ever needed for the local LAN backend
      during development.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
